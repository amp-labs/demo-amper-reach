{
  "name": "amperreach",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot server/index.ts",
    "start": "NODE_ENV=production bun server/index.ts",
    "check": "vp check",
    "prepare": "test ! -x node_modules/.bin/vp || vp config --no-agent"
  },
  "dependencies": {
    "@amp-labs/react": "2.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "svix": "2.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  }
}
